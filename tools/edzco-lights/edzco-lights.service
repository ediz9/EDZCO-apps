[Unit]
Description=EDZCO exterior lights
After=vsomeipd.service

[Service]
# root: the vsomeip policy lets uid 0 reach the diagnostic gateway (TASU 0xF8A6), which is
# how the lamp functions are written.
ExecStart=/usr/bin/node /var/opt/edzco-lights/current/lights.js
StandardOutput=journal
Restart=always
RestartSec=5

RuntimeDirectory=edzco-lights
RuntimeDirectoryMode=0755

# give the release sweep time to hand every lamp back before systemd kills us
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target
