[Unit]
Description=EDZCO exterior lights service
Documentation=file:/opt/edzco-lights/README.md
After=network.target hmictl.service
Wants=hmictl.service

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/edzco-lights/lights.js
WorkingDirectory=/opt/edzco-lights
Restart=on-failure
RestartSec=3

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/edzco-lights /var/log/edzco-lights
RuntimeDirectory=edzco-lights
RuntimeDirectoryMode=0755
LogsDirectory=edzco-lights
LogsDirectoryMode=0755

[Install]
WantedBy=multi-user.target
