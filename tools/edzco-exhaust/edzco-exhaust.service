[Unit]
Description=EDZCO exhaust (Pop-Bang) control service
Documentation=file:/opt/edzco-exhaust/README.md
After=network.target hmictl.service
Wants=hmictl.service

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/edzco-exhaust/exhaust.js
WorkingDirectory=/opt/edzco-exhaust
Restart=on-failure
RestartSec=3

# the tool holds no secrets; ambient reach restricted to what it needs
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/edzco-exhaust /var/log/edzco-exhaust
RuntimeDirectory=edzco-exhaust
RuntimeDirectoryMode=0755
LogsDirectory=edzco-exhaust
LogsDirectoryMode=0755

[Install]
WantedBy=multi-user.target
