[Unit]
Description=EDZCO sound effects service (Pop-Bang)
Documentation=file:/opt/edzco-sound/README.md
After=network.target sound.target
Wants=sound.target

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/edzco-sound/sound.js
WorkingDirectory=/opt/edzco-sound
Restart=on-failure
RestartSec=3

# the PCM the app routes to the speakers; override here if aplay -L names it differently
Environment=EDZCO_PCM=plug:smartx:CarLifeMedia_CF_48_STEREO

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/edzco-sound /var/log/edzco-sound
RuntimeDirectory=edzco-sound
RuntimeDirectoryMode=0755
LogsDirectory=edzco-sound
LogsDirectoryMode=0755

[Install]
WantedBy=multi-user.target
