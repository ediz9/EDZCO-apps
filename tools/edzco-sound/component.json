{
  "id": "edzco-sound",
  "kind": "tool",
  "version": "0.1.0",
  "title": "Sound",
  "description": "The service behind Pop-Bang. Plays short overrun effects into the head unit's CarLifeMedia PCM (plug:smartx:CarLifeMedia_CF_48_STEREO, 48 kHz stereo), which the app routes to the main speaker through the GENIVI AudioManager. Runs as root because an OAP app has no access to the audio devices. Ships twenty effects (ten synthesised, ten recorded) and a probe command that reports what this head unit actually has for audio.",
  "optional": true,
  "uninstallable": true,
  "mguHmi": [
    "ID7"
  ],
  "requires": {
    "mgu-deploy": "0.7.11"
  },
  "files": [
    {
      "path": "sound.js",
      "from": "sound.js",
      "mode": "0644"
    },
