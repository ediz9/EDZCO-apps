{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "exclude": [
      "_template",
      "wip"
    ],
    "mguHmi": [
      "ID7",
      "ID8"
    ],
    "build": {
      "python": "kit/tools/build.py",
      "args": [
        "{id}"
      ],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}.tgz"
    }
  },
  "tools": [
    {
      "id": "edzco-sound",
      "path": "tools/edzco-sound",
      "title": "Sound",
      "description": "Plays Pop-Bang's effects into the head unit's CarLifeMedia PCM, which the app routes to the speakers through the AudioManager.",
      "optional": true,
      "uninstallable": true,
      "mguHmi": [
        "ID7",
        "ID8"
      ]
    },
    {
      "id": "edzco-lights",
      "path": "tools/edzco-lights",
      "title": "Exterior Lights",
      "description": "Drives the exterior lamps through the body controller's own test functions for the Lights app's patterns.",
      "optional": true,
      "uninstallable": true,
      "mguHmi": [
        "ID7",
        "ID8"
      ]
    }
  ]
}